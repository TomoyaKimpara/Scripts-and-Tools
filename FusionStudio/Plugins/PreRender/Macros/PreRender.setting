{
	Tools = ordered() {
		PreRender = GroupOperator {
			Inputs = ordered() {
				MainInput1 = InstanceInput { Name = "Input", SourceOp = "PR_Input", Source = "Input" },
				Filename = InstanceInput { Name = "Filename", SourceOp = "PR_Saver", Source = "Clip", Page = "PreRender" },
				OutputFormat = InstanceInput { Name = "Output Format", SourceOp = "PR_Saver", Source = "OutputFormat", Page = "PreRender" },
				PR_FirstFrame = Input {
					Value = 4
				},
				PR_LastFrame = Input {
					Value = 6
				}
			},
			UserControls = {
				PR_Render = {
					BTNCS_Execute = "local f=assert(loadfile(comp:MapPath('Scripts:Support/PreRender_v13.lua'))); f()('render', tool, comp)",
					INPID_InputControl = "ButtonControl",
					LINKID_DataType = "Number",
					ICS_ControlPage = "PreRender",
					LINKS_Name = "Render Range / Update Proxy..."
				},
				PR_LastFrame = {
					INP_Integer = true,
					INPID_InputControl = "ScrewControl",
					INP_Default = 119,
					LINKID_DataType = "Number",
					ICS_ControlPage = "PreRender",
					LINKS_Name = "End Frame"
				},
				PR_OpenFolder = {
					BTNCS_Execute = "local f=assert(loadfile(comp:MapPath('Scripts:Support/PreRender_v13.lua'))); f()('openfolder', tool, comp)",
					INPID_InputControl = "ButtonControl",
					LINKID_DataType = "Number",
					ICS_ControlPage = "PreRender",
					LINKS_Name = "Open Containing Folder"
				},
				PR_FirstFrame = {
					INP_Integer = true,
					INPID_InputControl = "ScrewControl",
					INP_Default = 0,
					LINKID_DataType = "Number",
					ICS_ControlPage = "PreRender",
					LINKS_Name = "Start Frame"
				},
				PR_Current = {
					BTNCS_Execute = "local f=assert(loadfile(comp:MapPath('Scripts:Support/PreRender_v13.lua'))); f()('current', tool, comp)",
					INPID_InputControl = "ButtonControl",
					LINKID_DataType = "Number",
					ICS_ControlPage = "PreRender",
					LINKS_Name = "Render Current Frame"
				},
				PR_UseCompRange = {
					CBC_TriState = false,
					INPID_InputControl = "CheckboxControl",
					INP_Default = 1,
					LINKID_DataType = "Number",
					ICS_ControlPage = "PreRender",
					LINKS_Name = "Use Composition Range"
				}
			},
			Tools = ordered() {
				PR_Input = PipeRouter {
				},
				PR_Saver = Saver { Inputs = {
						OutputFormat = Input { Value = FuID { "OpenEXRFormat" } },
						Clip = Input { Value = Clip { FormatID = "OpenEXRFormat", Filename = "Temp:/PreRender_SetFilename.exr", Saving = true } }
					}, PassThrough = true },
				PR_Loader = Loader {
					Clips = {
						Clip {
							ExtendFirst = 0,
							Loop = 1,
							TrimIn = 0,
							ExtendLast = 0,
							StartFrame = -1,
							Length = 1,
							GlobalStart = 0,
							TrimOut = 0,
							FormatID = "PNGFormat",
							ID = "Clip1",
							GlobalEnd = 0,
							Filename = "Scripts:Support/PreRender_placeholder.png",
							LengthSetManually = true
						}
					}
				},
				PR_Switch = Dissolve {
					Inputs = {
						Mix = Input { Value = 1 },
						Foreground = Input { Source = "Output", SourceOp = "PR_Loader" },
						Background = Input { Source = "Output", SourceOp = "PR_Input" }
					}
				}
			},
			Outputs = { MainOutput1 = InstanceOutput { Name = "Output", SourceOp = "PR_Switch", Source = "Output" } },
			Colors = { TileColor = { R = 0.584313725490196, B = 0.803921568627451, G = 0.294117647058824 } }
		}
	}
}