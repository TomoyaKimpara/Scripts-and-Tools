				Sp_TheVoid = Background {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						GlobalOut = Input { Value = 78, },
						Width = Input {
							Value = 720,
							Expression = ":\nc = Sp_ctrl\nwA = self.widthA\nwB = self.widthB\n\n-- 1. Determine base width (Optimized logic path)\nbaseW = 0\nsrc = c.SizeSource\n\nif src == 0 then     -- Selection: A\n    baseW = (wA > 0 and wA) or (wB > 0 and wB) or c.CustomWidth\nelseif src == 1 then -- Selection: B\n    baseW = (wB > 0 and wB) or (wA > 0 and wA) or c.CustomWidth\nelse                 -- Selection: Custom\n    baseW = c.CustomWidth\nend\n\n-- 2. Scale & Layout (Prioritized: 2, 0, 4, 1, 3)\ns = c.OutputScale\nscale = (s == 2 and 0.5) or (s == 0 and 1) or (s == 4 and 0.25) or (s == 1 and 0.667) or 0.333\nmult = (c.Layout == 0) and 2 or 1\n\n-- Final result: Math.max keeps it from breaking Fusion's internal limit\nreturn max(2, floor(baseW * scale) * mult)",
						},
						Height = Input {
							Value = 640,
							Expression = ":\nc = Sp_ctrl\nhA = self.heightA\nhB = self.heightB\n\n-- 1. Determine base height (Optimized logic path)\nbaseH = 0\nsrc = c.SizeSource\n\nif src == 0 then     -- Selection: A\n    baseH = (hA > 0 and hA) or (hB > 0 and hB) or c.CustomHeight\nelseif src == 1 then -- Selection: B\n    baseH = (hB > 0 and hB) or (hA > 0 and hA) or c.CustomHeight\nelse                 -- Selection: Custom\n    baseH = c.CustomHeight\nend\n\n-- 2. Scale & Layout (Prioritized: 2, 0, 4, 1, 3)\ns = c.OutputScale\nscale = (s == 2 and 0.5) or (s == 0 and 1) or (s == 4 and 0.25) or (s == 1 and 0.667) or 0.333\nmult = (c.Layout == 1) and 2 or 1\n\n-- Final result: Math.max keeps it from breaking Fusion's internal limit\nreturn max(2, floor(baseH * scale) * mult)",
						},
