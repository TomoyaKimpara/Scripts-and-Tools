						LayerOrder = Input { Value = ScriptVal { {
									[0] = 3,
									1,
									2
								} }, },
						Background = Input {
							SourceOp = "Sp_VoidHammer",
							Source = "Output",
						},
						["Layer1.Foreground"] = Input {
							SourceOp = "Sp_DivCC",
							Source = "Output",
						},
						["Layer1.Size"] = Input { Value = 16, },
						["Layer1.Angle"] = Input { Expression = "Sp_SplitDivMsk.Angle", },
						["Layer1.Operator"] = Input { Value = FuID { "In" }, },
						["Layer1.Edges"] = Input { Value = 1, },
						["Layer1.FilterMethod"] = Input { Value = 0, },
						LayerName1 = Input { Value = "Sp_DivCC Layer", },
						["Layer2.Foreground"] = Input {
							SourceOp = "Sp_DivStack",
							Source = "Output",
						},
						["Layer2.Operator"] = Input { Value = FuID { "In" }, },
						["Layer2.Blend"] = Input { Expression = "min(Sp_ctrl.DivType, 1)", },
						["Layer2.Edges"] = Input { Value = 1, },
						LayerName2 = Input { Value = "Sp_DivStack Layer", },
						["Layer3.Foreground"] = Input {
							SourceOp = "Sp_SplitDivMsk",
							Source = "Mask",
						},
						["Layer3.Center"] = Input { Expression = ":\nv = Sp_TheVoid\na = Sp_ctrl.SplitAngle\nb = Sp_ctrl.SplitAngle\nx = Sp_SplitOffset.Center.X\ny = Sp_SplitOffset.Center.Y\n\n-- Check if the angle is 1 or 5 (Vertical) or 3 or 7 (Horizontal) \n-- (Assuming 1-8 scale where 1 is Vertical)\nisVertical = (a == 1 or a == 5)\nisHorizontal = (a == 3 or a == 7)\n\nsnapX = v.Width%2==0 and 0 or 0.5/v.Width\nsnapY = v.Height%2==0 and 0 or 0.5/v.Height\n\nreturn Point(isVertical and (x + snapX) or x, isHorizontal and (y + snapY) or y)", },
						["Layer3.Size"] = Input {
							Value = 0.25,
							Expression = ":\nlocal c = Sp_ctrl\nlocal scales = {[0]=1, 0.667, 0.5, 0.333, 0.25}\nlocal scale = scales[c.OutputScale] or 1\n\nreturn 1 --scale",
						},
						["Layer3.Blend"] = Input { Expression = "(Sp_ctrl.Offset==0 or Sp_ctrl.Offset==1) and 0 or Sp_ctrl.DivOpacity", },
						["Layer3.FilterMethod"] = Input { Value = 0, },
						LayerName3 = Input { Value = "Sp_SplitDivMsk Layer", }
					},
					ViewInfo = OperatorInfo { Pos = { 110, 379.5 } },
					Colors = { TileColor = { R = 0.266666666666667, G = 0.56078431372549, B = 0.396078431372549 }, }
