				Sp_MagXB = Transform {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						OffsetB = Input {
							Value = Point {
								X = 0.025,
								Y = 0
							},
						},
						SizeB = Input {
							Value = Number {
								Value = 9
							},
						},
						AngleB = Input {
							Value = Number {
								Value = 18.3
							},
						},
						PivotB = Input {
							Value = Point {
								X = 0.709,
								Y = 0.553
							},
						},
						ViewControls = Input {
							Value = Number {
								Value = 1
							},
						},
						Blend = Input { Expression = "1-Sp_ctrl.Disable", },
						Quality = Input { Value = 5, },
						Pivot = Input {
							Value = { 1, 0.5 },
							Expression = ":\nlocal s = self.Input\nlocal c = Sp_ctrl\n\n-- 1. Grab Raw Base (Container)\n-- 1. Grab Raw Base (Container) - Updated for Phase 3\nlocal bW = (c.SizeSource == 0) and Sp_SDA.Output.Width or (c.SizeSource == 1 and Sp_SDB.Output.Width or c.CustomWidth)\nlocal bH = (c.SizeSource == 0) and Sp_SDA.Output.Height or (c.SizeSource == 1 and Sp_SDB.Output.Height or c.CustomHeight)\n\n-- 2. Canvas-to-Source Ratios (This is the magic that fixes the drifting)\nlocal rX = (bW * ((c.Layout == 0) and 2 or 1)) / s.OriginalWidth\nlocal rY = (bH * ((c.Layout == 1) and 2 or 1)) / s.OriginalHeight\n\n-- 3. Split-Aware Anchors\n-- If Layout is 2 (Split), anchor is 0.5. Otherwise, use the Stack logic.\nlocal aX = (c.Layout == 2) and 0.5 or ((c.Layout == 0) and ((c.Flip == 0) and 0.75 or 0.25) or 0.5)\nlocal aY = (c.Layout == 2) and 0.5 or ((c.Layout == 1) and ((c.Flip == 0) and 0.25 or 0.75) or 0.5)\n\nreturn Point(0.5 + (Sp_Widget.Center.X - aX) * rX, 0.5 + (Sp_Widget.Center.Y - aY) * rY)",
						},
						Size = Input { Expression = ": \nlocal steps = {1, 3, 2, 3, 4}\nlocal s = steps[Sp_ctrl.OutputScale + 1]\n\nif Sp_ctrl.Snap == 0 then \n    return Sp_ctrl.Magnify \nend\n\n-- 1. The \"Sub-One\" Zone\nif Sp_ctrl.Magnify < 0.75 then\n    if Sp_ctrl.Magnify > 0.25 then \n        return 0.5\n    else \n        return 0.0\n    end\nend\n\n-- If Magnify is between 1.0 and 1.5, we force it to 1.0 \n-- to prevent the s=2 (50%) scale from snapping 1.0 up to 2.0.\nif Sp_ctrl.Magnify <= s * 0.75 then \n    return 1.0 \nend\n\nreturn math.max(1, math.floor(Sp_ctrl.Magnify / s + 0.5) * s)", },
						XSize = Input { Value = 2.25, },
						YSize = Input { Value = 2.25, },
						FilterMethod = Input { Expression = "(Sp_ctrl.OutputScale==0 and Sp_ctrl.Magnify<1) and 2 or Sp_ctrl.Snap==1 and 0 or 2", },
						Input = Input {
							SourceOp = "Sp_SDB",
							Source = "Output",
						}
					},
					ViewInfo = OperatorInfo { Pos = { 220, 49.5 } },
					Colors = { TileColor = { R = 0.92156862745098, G = 0.431372549019608, B = 0 }, }
