					},
					ViewInfo = OperatorInfo { Pos = { -165, 16.5 } },
					Colors = { TileColor = { R = 0.725490196078431, G = 0.690196078431373, B = 0.592156862745098 }, }
				},
				Sp_StackMixanoid = MultiMerge {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						EffectMask = Input {
							SourceOp = "Sp_Widget",
							Source = "Mask",
						},
						HideInputs = Input { Value = 1, },
						LayerOrder = Input { Value = ScriptVal { {
									[0] = 3,
									1,
									2,
									6
								} }, },
						Background = Input {
							SourceOp = "Sp_VoidHammer",
							Source = "Output",
						},
						["Layer1.Foreground"] = Input {
							SourceOp = "Sp_CropXA",
							Source = "Output",
						},
						["Layer1.Center"] = Input { Expression = ":\n-- Since Resize logic is slaved to Sp_TheVoid, we trust the 1:1 pixel mapping.\n-- Layout 0: Horizontal Stack (Side-by-Side)\n-- Layout 1: Vertical Stack (Top-Bottom)\n\nif Sp_ctrl.Layout == 0 then\n    -- Horizontal: Left (0.25) or Right (0.75)\n    local posX = (Sp_ctrl.Flip == 0) and 0.25 or 0.75\n    return Point(posX, 0.5)\nelse\n    -- Vertical: Top (0.75) or Bottom (0.25)\n    local posY = (Sp_ctrl.Flip == 0) and 0.75 or 0.25\n    return Point(0.5, posY)\nend", },
						["Layer1.Blend"] = Input { Expression = ":\n-- If ShowInput is \"Hide A\" (2) and Flip is 0, OR \"Hide B\" (1) and Flip is 1...\nhide = (Sp_ctrl.ShowInput == 2 and Sp_ctrl.Flip == 0) or (Sp_ctrl.ShowInput == 1 and Sp_ctrl.Flip == 1)\n\nreturn hide and 0 or 1", },
						["Layer1.FilterMethod"] = Input { Value = 0, },
						LayerName1 = Input { Value = "SwtchA Layer", },
						["Layer2.Foreground"] = Input {
							SourceOp = "Sp_CropXB",
							Source = "Output",
						},
						["Layer2.Center"] = Input { Expression = ":\nif Sp_ctrl.Layout == 0 then\n    -- Horizontal: Right (0.75) or Left (0.25)\n    local posX = (Sp_ctrl.Flip == 0) and 0.75 or 0.25\n    return Point(posX, 0.5)\nelseif Sp_ctrl.Layout == 1 then\n    -- Vertical: Bottom (0.25) or Top (0.75)\n    local posY = (Sp_ctrl.Flip == 0) and 0.25 or 0.75\n    return Point(0.5, posY)\nend\n\nreturn Point(0.5, 0.5)", },
						["Layer2.Blend"] = Input { Expression = ":\n-- If ShowInput is \"Hide A\" (2) and Flip is 0, OR \"Hide B\" (1) and Flip is 1...\nhide = (Sp_ctrl.ShowInput == 2 and Sp_ctrl.Flip == 1) or (Sp_ctrl.ShowInput == 1 and Sp_ctrl.Flip == 0)\n\nreturn hide and 0 or 1", },
						["Layer2.FilterMethod"] = Input { Value = 0, },
						LayerName2 = Input { Value = "SwtchB Layer", },
						["Layer3.Foreground"] = Input {
							SourceOp = "Sp_HammerTimeBGA",
							Source = "Output",
						},
						["Layer3.Size"] = Input { Value = 16, },
						["Layer3.Blend"] = Input { Expression = "Sp_ctrl.ShowBG", },
						["Layer3.Edges"] = Input { Value = 1, },
						["Layer3.FilterMethod"] = Input { Value = 0, },
						LayerName3 = Input { Value = "Sp_HammerTimeBGA Layer", },
						LayerEnabled4 = Input { Value = 0, },
						LayerEnabled5 = Input { Value = 0, },
						["Layer6.Foreground"] = Input {
							SourceOp = "Sp_FreezeSucka",
							Source = "Output",
						},
						LayerName6 = Input { Value = "Sp_FreezeSucka Layer", }
					},
					ViewInfo = OperatorInfo { Pos = { 0, 214.5 } },
					Colors = { TileColor = { R = 0.92156862745098, G = 0.431372549019608, B = 0 }, }
				},
				Sp_CropXA = Crop {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						XOffset = Input { Expression = "(0.5 * self.Input.OriginalWidth) - (0.5 * XSize)", },
						YOffset = Input { Expression = "(0.5 * self.Input.OriginalHeight) - (0.5 * YSize)", },
						XSize = Input {
							Value = 360,
							Expression = "Sp_CropXB.XSize",
						},
						YSize = Input {
							Value = 640,
							Expression = "Sp_CropXB.YSize",
						},
