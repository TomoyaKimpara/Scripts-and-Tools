				Sp_SDA = SetDomain {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						LayersNest = Input { Value = 0, },
						Mode = Input { Value = FuID { "Set" }, },
						CommentsNest = Input { Value = 0, },
