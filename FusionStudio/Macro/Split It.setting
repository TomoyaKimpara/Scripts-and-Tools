						Source = Input { Expression = ":\n-- 1. Master Bypass\nif Sp_SDB.Input == nil then return 0 end -- If Input B is missing, we don't care about transforms\nif Sp_ctrl.Disable == 1 then return 0 end\n\n\n-- 2. Transform Detection\n-- Check if the transform values are at their defaults. \n-- If they ARE at defaults, we use the Basic path (0).\nlocal isTransformActive = (\n    Sp_ctrl.Magnify ~= 1 or\n    Sp_Widget.Angle ~= 0\n)\n\n-- Only use the Transform path (1) if the toggle is ON AND something is moving.\nreturn isTransformActive and 1 or 0", },
