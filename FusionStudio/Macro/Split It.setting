					Colors = { TileColor = { R = 0.92156862745098, G = 0.431372549019608, B = 0 }, }
				},
				Sp_SplitOffset = Transform {
					CtrlWZoom = false,
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Quality = Input { Value = 5, },
						HideInputs = Input { Value = 1, },
						LayersNest = Input { Value = 0, },
						Center = Input { Expression = ":\nA = Sp_ctrl.SplitAngle\nO = Sp_ctrl.Offset\n\nreturn\nA == 1 and Point(O, 0.5) or\nA == 2 and Point(O, 1-O) or\nA == 3 and Point(0.5, 1-O) or\nA == 4 and Point(1-O, 1-O) or\nA == 5 and Point(1-O, 0.5) or\nA == 6 and Point(1-O, O) or\nA == 7 and Point(0.5, O) or\nPoint(O, O)", },
						Edges = Input { Value = 3, },
						FilterMethod = Input { Value = 0, },
