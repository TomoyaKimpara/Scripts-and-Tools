				},
				Sp_SplitMskFix = ChannelBoolean {
					CtrlWShown = false,
					NameSet = true,
					Inputs = {
						Blend = Input { Expression = ":\nlocal mode = Sp_ctrl.ShowInput\nlocal hasA = (Sp_SDA.Output ~= nil) and 1 or 0\nlocal hasB = (Sp_SDB.Output ~= nil) and 1 or 0\n\n-- 1. Dual Mode (0): If both are active, we want a solid alpha (1).\nif mode == 0 then\n    return (hasA == 1 and hasB == 1) and 1 or 0\nend\n\n-- 2. Solo A (1): We only want the solid alpha fix if A actually exists.\nif mode == 1 then\n    return (hasA == 1) and 1 or 0\nend\n\n-- 3. Solo B (2): We only want the solid alpha fix if B actually exists.\nif mode == 2 then\n    return (hasB == 1) and 1 or 0\nend\n\nreturn 0", },
						ProcessRed = Input { Value = 0, },
						ProcessGreen = Input { Value = 0, },
						ProcessBlue = Input { Value = 0, },
						HideInputs = Input { Value = 1, },
						LayersNest = Input { Value = 0, },
						ToRed = Input { Value = 4, },
						ToGreen = Input { Value = 4, },
						ToBlue = Input { Value = 4, },
						ToAlpha = Input { Value = 16, },
						ToXNormal = Input { Value = 5, },
						ToYNormal = Input { Value = 6, },
						ToZNormal = Input { Value = 7, },
