						["Layer1.Foreground"] = Input {
							SourceOp = "Sp_SplitMskFix",
							Source = "Output",
						},
						["Layer1.Blend"] = Input { Expression = "(Sp_SDA.Output == nil and Sp_SDB.Output == nil ) and 0 or 1", },
						["Layer1.FilterMethod"] = Input { Value = 0, },
						LayerName1 = Input { Value = "Sp_SplitMskFix Layer", },
						["Layer2.Foreground"] = Input {
							SourceOp = "Sp_SplitMixanoid",
							Source = "Output",
						},
						["Layer2.Operator"] = Input {
							Value = FuID { "In" },
							Expression = ":\nlocal c = Sp_ctrl\nlocal hasA = (Sp_SDA.Output ~= nil) and 1 or 0\nlocal hasB = (Sp_SDB.Output ~= nil) and 1 or 0\n\n-- 1. DUAL MODE (A and B both present)\nif hasA == 1 and hasB == 1 then\n    return \"In\"\nend\n\n-- 2. SOLO A MODE (B is missing)\nif hasA == 1 and hasB == 0 then\n    -- SWAPPED: Flip 0 now shows A, Flip 1 masks out A\n    return (c.Flip == 1) and \"Held Out\" or \"In\"\nend\n\n-- 3. SOLO B MODE (A is missing)\nif hasB == 1 and hasA == 0 then\n    -- Keeping this as is since you said B was giving expected results\n    return (c.Flip == 1) and \"Held Out\" or \"In\"\nend\n\nreturn \"In\"",
						},
						["Layer2.FilterMethod"] = Input { Value = 0, },
						LayerName2 = Input { Value = "Sp_SplitMixanoid Layer", },
						["Layer3.Foreground"] = Input {
